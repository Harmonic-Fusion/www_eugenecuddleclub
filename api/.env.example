# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# Never commit .env — it holds secrets. This example file is safe to commit.

# Required. Ticket Tailor API key for your box office (starts with sk_).
# Create one in Ticket Tailor: Box office settings → API keys.
# Docs: https://developers.tickettailor.com/docs/api/ticket-tailor-api
TICKET_TAILOR_API_KEY=sk_your_key_here

# Comma-separated origins allowed to call this API from a browser.
# Include the live site and local Eleventy preview (pnpm start → :8080).
# On Railway, set the same variable in the service's Variables UI.
CORS_ORIGINS=https://eugenecuddleclub.com,http://localhost:8080

# Optional. Override only if Ticket Tailor gives you a different API host.
# TICKET_TAILOR_BASE_URL=https://api.tickettailor.com/v1

# -----------------------------------------------------------------------------
# Postgres (required for login / email cache)
# -----------------------------------------------------------------------------
# Scheme must be postgresql+asyncpg:// (SQLAlchemy async driver).
#
# Local with docker compose (recommended):
#   1. From the repo root: docker compose up -d db
#   2. Keep this localhost URL when running the API on the host (pnpm start:api).
#   3. Apply schema once: cd api && .venv/bin/alembic upgrade head
#   Compose credentials match the db service: user/password/db = ecc/ecc/ecc
#
# Local API running inside Compose (docker compose up --build):
#   The compose file overrides DATABASE_URL to use host "db" instead of localhost.
#   You do not need to change this file for that path.
#
# Railway:
#   1. Add a Postgres plugin to the API service.
#   2. Copy the connection URL Railway provides.
#   3. If it starts with postgresql:// or postgres://, change the scheme to
#      postgresql+asyncpg:// (keep user, password, host, port, and database).
DATABASE_URL=postgresql+asyncpg://ecc:ecc@localhost:5432/ecc

# JWT signing secret (long random string). Required for login.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Public site origin (no trailing slash). Used for OAuth / magic-link redirects.
# Local Eleventy: http://localhost:8080
# Production:     https://eugenecuddleclub.com
SITE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Google OAuth (Gmail sign-in)
# -----------------------------------------------------------------------------
# Used when someone enters a @gmail.com / @googlemail.com ticket email.
#
# Setup:
#   1. Open Google Cloud Console → APIs & Services → Credentials
#      https://console.cloud.google.com/apis/credentials
#   2. Configure the OAuth consent screen (External is fine for a small club site).
#   3. Create credentials → OAuth client ID → Application type: Web application.
#   4. Under Authorized redirect URIs, add exactly:
#        Local:      http://localhost:8000/auth/google/callback
#        Production: https://<your-railway-host>/auth/google/callback
#      GOOGLE_REDIRECT_URI below must match one of those URIs character-for-character.
#   5. Copy Client ID → GOOGLE_CLIENT_ID
#   6. Copy Client secret → GOOGLE_CLIENT_SECRET
#
# Leave ID/secret blank to disable Google sign-in (email code still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# -----------------------------------------------------------------------------
# Resend (login codes + magic links)
# -----------------------------------------------------------------------------
# Sends the 6-digit code and magic link email for non-Google (and optional Gmail)
# sign-in. https://resend.com/
#
# Setup:
#   1. Create an account and an API key (Dashboard → API Keys).
#   2. Paste the key into RESEND_API_KEY (starts with re_).
#   3. RESEND_FROM:
#        Local / testing: keep onboarding@resend.dev (Resend only delivers to
#          the email address on your Resend account).
#        Production: use the club address —
#          Eugene Cuddle Club <community@eugenecuddleclub.com>
#          Namecheap Private Email already receives mail for that inbox; Resend
#          is only for *sending* login codes via API. In Resend → Domains, add
#          and verify eugenecuddleclub.com (SPF/DKIM DNS records). Keep Namecheap’s
#          MX records for Private Email; Resend’s docs show which TXT/CNAME
#          records to add alongside them.
#
# If RESEND_API_KEY is empty, the API skips sending and logs the code in the
# server console so you can still test login locally.
RESEND_API_KEY=
RESEND_FROM=Eugene Cuddle Club <community@eugenecuddleclub.com>
